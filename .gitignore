# Data — never commit
*.csv
*.parquet
data/shards/

# Run outputs
results/runs/
*.pth
*.pt

# Operational state (not a contribution artifact) -- e.g. state/hotswap_log/
# events.jsonl. Its own audit trail is the append-only file itself (fsync,
# per-record timestamp + code_version + resulting_checkpoint_sha256), not
# git history -- git-tracking it would make every hot-swap during a demo
# or rehearsal a dirty-tree/commit event.
state/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.env

# OS
Thumbs.db

# Frontend
frontend/node_modules/
frontend/dist/

# results/ -- track what can't be cheaply regenerated, ignore the rest
results/**/*.npz
results/**/*.png
results/xgboost/
results/**/*_raw*.json
results/**/*.log
.vite/

# Exceptions: small, every-number-reads-from-these, or expensive/
# nondeterministic to regenerate (LLM calls, or a read against the
# spent test_global.parquet test set) -- must stay tracked.
!results/inspection/*.csv
!results/inspection/best_rounds_manifest.json
# ...and these two: served live by GET /faithfulness/*.png and rendered
# by the Faithfulness page -- not illustrative like the other figures.
!results/figures/deletion_curve.png
!results/figures/insertion_curve.png
# Startup-critical for the SERVED model only (configs/backend.yaml model.tag):
# these two stay tracked. The backend also needs streamed_pool.npz and
# eval_rows_sidecar.npz, but those are untracked -- see below and README.md.
# Deliberately scoped to the one tag -- not results/shap/**, which would also
# un-ignore every other tag's and round_wise/'s global_shap.npz.
!results/shap/fedavg_a0.5_s42/global_shap.npz
!results/federated/fedavg_a0.5_s42/round_checkpoints/round_018.pt

# Demo data -- untracked and ignored; regenerated locally via the commands in
# README.md ("Reproducing the demo data"), not redistributed.
results/shap/**/streamed_pool.npz
results/shap/**/eval_rows_sidecar.npz

# Local working documents -- not part of the repo
XFED_PLAYBOOK.md
PHASE2_OPENING_PROMPT.md
